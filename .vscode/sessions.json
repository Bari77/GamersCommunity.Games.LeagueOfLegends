{
  "$schema": "https://cdn.statically.io/gh/nguyenngoclongdev/cdn/main/schema/v11/terminal-keeper.json",
  "theme": "neon",
  "active": "default",
  "activateOnStartup": true,
  "keepExistingTerminals": false,
  "noClear": true,
  "sessions": {
    "default": [
      [
        {
          "name": "LoL.Consumer",
          "cwd": "LeagueOfLegends.Consumer",
          "icon": "circuit-board",
          "color": "terminal.ansiBlue",
          "isTransient": true,
          "autoExecuteCommands": true,
          "commands": [
            "dotnet run"
          ]
        },
        {
          "name": "LoL.Front",
          "cwd": "LeagueOfLegends.Front",
          "icon": "game",
          "color": "terminal.ansiRed",
          "isTransient": true,
          "focus": true,
          "autoExecuteCommands": true,
          "commands": [
            "npm start"
          ]
        }
      ]
    ]
  }
}
